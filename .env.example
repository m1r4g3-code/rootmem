# Copy this file to .env and adjust as needed for local development.
# config.py fails fast at startup if a required variable is missing or invalid.

# Postgres
POSTGRES_USER=rootmem
POSTGRES_PASSWORD=rootmem_dev_password
POSTGRES_DB=rootmem
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# "prefer" works against both a local Postgres with no SSL configured and a
# hosted instance (e.g. Neon) that mandates it — see ADR 0011. Only change
# this if you specifically need "require"/"disable".
POSTGRES_SSLMODE=prefer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Default namespace used when a tool call omits one
ROOTMEM_DEFAULT_NAMESPACE=default

# Logging
ROOTMEM_LOG_LEVEL=INFO
