# Copy this file to .env and adjust as needed for local development.
# config.py fails fast at startup if a required variable is missing or invalid.

# Postgres
POSTGRES_USER=rootmem
POSTGRES_PASSWORD=rootmem_dev_password
POSTGRES_DB=rootmem
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# "prefer" works against both a local Postgres with no SSL configured and a
# hosted instance (e.g. Neon) that mandates it — see ADR 0011. Only change
# this if you specifically need "require"/"disable".
POSTGRES_SSLMODE=prefer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Default namespace used when a tool call omits one
ROOTMEM_DEFAULT_NAMESPACE=default

# Logging
ROOTMEM_LOG_LEVEL=INFO

# Phase 1 external LLM APIs (ADR 0009) — required for the real
# EmbeddingProvider/ExtractionProvider implementations; unit tests against
# fakes need neither.
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
# VOYAGE_MODEL=voyage-4
# VOYAGE_OUTPUT_DIMENSION=1024
# EXTRACTION_MODEL=claude-haiku-4-5-20251001
# HYBRID_SEARCH_WEIGHT_TEXT=0.5
# HYBRID_SEARCH_WEIGHT_VECTOR=0.5
# CONTRADICTION_CONFIDENCE_FLOOR=0.5

# Phase 5 (ADR 0028): transport. stdio (default) is unchanged. http serves
# streamable HTTP and REQUIRES a bearer token issued with
#   python -m rootmem.identity.cli create --name <agent> --namespace <ns>
# It binds loopback unless ROOTMEM_HTTP_ALLOW_NON_LOOPBACK=true (terminate TLS
# in a reverse proxy).
# ROOTMEM_TRANSPORT=stdio
# ROOTMEM_HTTP_HOST=127.0.0.1
# ROOTMEM_HTTP_PORT=8765
# ROOTMEM_HTTP_ALLOW_NON_LOOPBACK=false

# Phase 5 (ADR 0031): integration tests run against <POSTGRES_DB>_test (create
# it once with `python scripts/create_test_db.py`). Override the name here.
# POSTGRES_TEST_DB=rootmem_test
